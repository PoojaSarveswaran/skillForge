# Copy this file to server/.env and fill in real local values.
# Never commit the real .env file.

PORT=4000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_NAME=skillforge
DB_USER=sf_app
DB_PASSWORD=change_me

# Used to sign demo-grade JWT session tokens. Generate your own random string.
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins for CORS.
CLIENT_ORIGIN=http://localhost:5173
